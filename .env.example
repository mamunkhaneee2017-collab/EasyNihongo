# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

GEMINI_API_KEY=

# Email a copy of every contact-form inquiry (backend/lib/notify.js).
# Free key at resend.com → API Keys. With the default sender, NOTIFY_EMAIL
# must be the address you signed up to Resend with.
RESEND_API_KEY=
NOTIFY_EMAIL=

# Set to true once the database lives on a persistent disk/volume
# (hides the "temporary storage" notice in the admin Messages view).
PERSISTENT_STORAGE=
